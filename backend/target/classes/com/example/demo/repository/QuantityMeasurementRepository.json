      "signature": "public abstract long com.example.demo.repository.QuantityMeasurementRepository.countByOperationAndIsErrorTrue(java.lang.String)",
      "query": {
        "query": "SELECT COUNT(q) FROM QuantityMeasurementEntity q WHERE q.operation = :operation AND q.isError = TRUE"
      }
