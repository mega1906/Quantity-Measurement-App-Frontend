      "signature": "public abstract long com.example.demo.repository.QuantityMeasurementRepository.countByOperation(java.lang.String)",
      "query": {
        "query": "SELECT COUNT(q) FROM QuantityMeasurementEntity q WHERE q.operation = :operation"
      }
    },
    {
